# Losant MCP Server Configuration
# Copy this file to .env and configure for your environment
# DO NOT commit .env files - they are in .gitignore

# ==============================================================================
# REQUIRED CONFIGURATION
# ==============================================================================

# Required: MCP server resource URL (must prefix-match JWT audience claim)
# This is the URL where your MCP server is accessible
# For local development: http://localhost:3000
# For production: https://mcp.losant.com/mcp, or the domain where you are 
# hosting the MCP server
LOSANT_RESOURCE_URL=http://localhost:3000

# ==============================================================================
# OPTIONAL CONFIGURATION
# ==============================================================================

# Optional: Server port (defaults to 3000)
# PORT=3000

# Optional: Server host (defaults to null, listens on all interfaces)
# For production, consider binding to a specific interface
# HOST=0.0.0.0

# Optional: Losant API URL (defaults to https://api.losant.com)
# Only change this if you're using a self-hosted Losant instance
# LOSANT_API_URL=https://api.losant.com

# Optional: Authorization server URL (defaults to https://accounts.losant.com/oauth)
# Only change this if you're using a self-hosted Losant instance
# Value has no effect if ENABLE_OAUTH is false
# LOSANT_AUTH_SERVER_URL=https://accounts.losant.com/oauth

# Optional: Node environment (defaults to production)
# Set to 'production' when deploying, 'development' when developing
# NODE_ENV=production

# ==============================================================================
# MCP CLIENT CONFIGURATION
# ==============================================================================

# Optional: MCP server title (appears in Claude Desktop and other MCP clients)
# (defaults to Losant)
# MCP_TITLE=Losant

# Optional: MCP server icon URL (must be a hosted PNG image)
# If not set, no icon will be displayed in MCP clients
# MCP_ICON_URL=https://your-domain.com/icon.png

# ==============================================================================
# ERROR REPORTING
# ==============================================================================

# Optional: Rollbar API key for error reporting
# Leave empty to disable Rollbar error reporting
# Get your key from https://rollbar.com
# ROLLBAR_KEY=your-rollbar-key-here

# ==============================================================================
# ADVANCED CONFIGURATION
# ==============================================================================

# Optional: Shutdown timeout (milliseconds, defaults to 10000)
# Time to wait for active connections to close during graceful shutdown
# SHUTDOWN_TIMEOUT=10000

# Optional: OAuth scopes (comma-separated list)
# Fallback scopes used when authorization server metadata is unavailable
# Only override if you need custom scopes
# LOSANT_OAUTH_SCOPES=all.Application.read, all.Application.bounded, only.Organization.read, only.Organization.bounded, all.Organization.read, all.Organization.bounded, only.User.read

# ==============================================================================
# Recommended: For local development or single use - Losant API Token (bypasses OAuth)
# ==============================================================================

# Optional: Losant API Token (This is typically used for local development and testing)
# If set, bypasses OAuth authentication
# LOSANT_API_TOKEN=your-api-token-here

# Optional: Enable OAuth discovery endpoints (defaults to false)
# Set to 'true' to enable /.well-known/oauth-protected-resource endpoint
# ENABLE_OAUTH=false
