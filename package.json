{
  "name": "losant-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for the Losant IoT Platform",
  "keywords": ["mcp", "iot", "losant", "model-context-protocol", "ai-tools"],
  "homepage": "https://github.com/Losant/losant-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/Losant/losant-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Losant/losant-mcp-server.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.4.0",
  "license": "MIT",
  "author": "Losant <hello@losant.com>",
  "type": "module",
  "bin": {
    "losant": "./bin/index.js"
  },
  "scripts": {
    "start": "NODE_ENV=production node bin/index.js",
    "start:dev": "NODE_ENV=development nodemon bin/index.js",
    "start:dev:oauth": "ENABLE_OAUTH=true pnpm start:dev",
    "test": "mocha 'test/**/*.test.js' --recursive",
    "test:coverage": "c8 mocha 'test/**/*.test.js' --recursive",
    "test:e2e": "ENABLE_OAUTH=false RUN_E2E=true mocha --recursive ./test/e2e/**/*.test.js",
    "prepare": "husky || true",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "lint:changed": "lint-staged",
    "reinstall": "rm -rf node_modules && pnpm install"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/hapi": "^21.4.9",
    "@hapi/inert": "^7.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "convict": "^6.2.5",
    "debug": "^4.4.3",
    "jsonwebtoken": "^9.0.3",
    "losant-rest": "^4.1.4",
    "memoizee": "^0.4.17",
    "omnibelt": "^4.1.0",
    "rollbar": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@losant/eslint-config-losant": "^2.1.0",
    "c8": "^10.1.3",
    "eslint": "^10.4.0",
    "esmock": "^2.7.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mocha": "^11.7.6",
    "nock": "^14.0.15",
    "nodemon": "^3.1.14",
    "should": "^13.2.3",
    "sinon": "^18.0.1"
  },
  "lint-staged": {
    "*.js": "eslint --max-warnings=0"
  }
}
